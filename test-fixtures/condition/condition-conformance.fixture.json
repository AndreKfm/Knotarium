{
  "$comment": [
    "B2 conformance fixture — language-neutral truth table for the Condition evaluator.",
    "Encodes condition-operator-semantics.md §5 (per-operator) and §6 (aggregation). Loaded by both",
    "the backend ConditionEvaluatorTests and the frontend conditionEval.test.ts so 'what you see ==",
    "what runs' is enforced by construction.",
    "",
    "OPERAND SHAPE (one comparator's operand):",
    "  { type: 'string'|'number'|'boolean', state?: 'value'|'unset'|'unresolved'|'absent', raw?: <json> }",
    "  - state defaults to 'value'; for 'value', 'raw' is the resolved RAW value EvaluatePropertyValue",
    "    would hand the evaluator (scalar, null, array, or object) BEFORE per-operand coercion (§3).",
    "  - 'unset'      = design-time unset operand (empty literal draft / no ref target) → Incomplete (§2.2).",
    "  - 'unresolved' = a configured ref that failed to resolve at runtime → RESOLUTION_FAILED (§2.3).",
    "  - 'absent'     = the operand slot is missing in persisted logic (e.g. binary op with no b).",
    "  Note: state 'value' with raw=null is a LEGITIMATE null, distinct from 'unresolved' (§2.3, §5.4).",
    "",
    "EXPECT: { status: 'True'|'False'|'Incomplete'|'Error', code?: ErrorCode, operand?: 'a'|'b'|null }",
    "  code/operand are asserted only for status=='Error' (per-operand error shape B7).",
    "  ErrorCode ∈ { INVALID_LOGIC, RESOLUTION_FAILED, COERCION_FAILED, TYPE_MISMATCH }.",
    "CROSS-TYPE ORDERING (§5.1): eq/ne over differing effective types stay defined (False/True), but",
    "  gt/gte/lt/lte over two resolved, non-null operands of differing (or same-but-non-orderable,",
    "  e.g. both boolean) effective types → Error(TYPE_MISMATCH, operand:null) → fail-node, never silent",
    "  false. A null operand on an ordering op stays False (absence, not a type conflict).",
    "Numeric comparison is EXACT — no epsilon (R11). eq/ne/gt/gte/lt/lte and numeric membership all use",
    "  the IEEE double ==/</> directly, so trichotomy holds (no value is both gt and lte at a boundary)."
  ],
  "version": 1,

  "cases": [
    { "id": "eq-num-num-equal",        "op": "eq", "a": { "type": "number", "raw": 5 },        "b": { "type": "number", "raw": 5 },        "expect": { "status": "True" } },
    { "id": "eq-num-num-tiny-diff-exact", "op": "eq", "a": { "type": "number", "raw": 1000000 }, "b": { "type": "number", "raw": 1000000.0005 }, "expect": { "status": "False" } },
    { "id": "eq-num-num-clearly-diff",  "op": "eq", "a": { "type": "number", "raw": 1 },        "b": { "type": "number", "raw": 1.01 },     "expect": { "status": "False" } },
    { "id": "eq-str-str-equal",        "op": "eq", "a": { "type": "string", "raw": "abc" },    "b": { "type": "string", "raw": "abc" },    "expect": { "status": "True" } },
    { "id": "eq-str-str-case-differs", "op": "eq", "a": { "type": "string", "raw": "ABC" },    "b": { "type": "string", "raw": "abc" },    "expect": { "status": "False" } },
    { "id": "eq-bool-bool-same",       "op": "eq", "a": { "type": "boolean", "raw": true },    "b": { "type": "boolean", "raw": true },    "expect": { "status": "True" } },
    { "id": "eq-bool-bool-diff",       "op": "eq", "a": { "type": "boolean", "raw": true },    "b": { "type": "boolean", "raw": false },   "expect": { "status": "False" } },
    { "id": "eq-null-null",            "op": "eq", "a": { "type": "string", "raw": null },     "b": { "type": "string", "raw": null },     "expect": { "status": "True" } },
    { "id": "eq-null-vs-value",        "op": "eq", "a": { "type": "number", "raw": null },     "b": { "type": "number", "raw": 1 },        "expect": { "status": "False" } },
    { "id": "eq-cross-type-num-str",   "op": "eq", "a": { "type": "number", "raw": 1 },        "b": { "type": "string", "raw": "1" },      "expect": { "status": "False" } },

    { "id": "ne-cross-type",           "op": "ne", "a": { "type": "number", "raw": 1 },        "b": { "type": "string", "raw": "1" },      "expect": { "status": "True" } },
    { "id": "ne-null-vs-value",        "op": "ne", "a": { "type": "string", "raw": null },     "b": { "type": "string", "raw": "x" },      "expect": { "status": "True" } },
    { "id": "ne-num-num-equal",        "op": "ne", "a": { "type": "number", "raw": 2 },        "b": { "type": "number", "raw": 2 },        "expect": { "status": "False" } },

    { "id": "gt-num-num-true",         "op": "gt",  "a": { "type": "number", "raw": 5 },       "b": { "type": "number", "raw": 3 },        "expect": { "status": "True" } },
    { "id": "gt-num-num-false",        "op": "gt",  "a": { "type": "number", "raw": 3 },       "b": { "type": "number", "raw": 5 },        "expect": { "status": "False" } },
    { "id": "gte-num-num-equal",       "op": "gte", "a": { "type": "number", "raw": 5 },       "b": { "type": "number", "raw": 5 },        "expect": { "status": "True" } },
    { "id": "lt-str-str-ordinal",      "op": "lt",  "a": { "type": "string", "raw": "apple" }, "b": { "type": "string", "raw": "banana" }, "expect": { "status": "True" } },
    { "id": "lte-str-str-equal",       "op": "lte", "a": { "type": "string", "raw": "x" },     "b": { "type": "string", "raw": "x" },      "expect": { "status": "True" } },
    { "id": "gt-uppercase-lt-lowercase-ordinal", "op": "lt", "a": { "type": "string", "raw": "Z" }, "b": { "type": "string", "raw": "a" }, "expect": { "status": "True" } },
    { "id": "gt-null-operand",         "op": "gt",  "a": { "type": "number", "raw": null },    "b": { "type": "number", "raw": 1 },        "expect": { "status": "False" } },
    { "id": "gt-cross-type-num-vs-str",  "op": "gt",  "a": { "type": "number", "raw": 5 },     "b": { "type": "string", "raw": "3" },    "expect": { "status": "Error", "code": "TYPE_MISMATCH", "operand": null } },
    { "id": "lt-cross-type-str-vs-num",  "op": "lt",  "a": { "type": "string", "raw": "a" },   "b": { "type": "number", "raw": 1 },      "expect": { "status": "Error", "code": "TYPE_MISMATCH", "operand": null } },
    { "id": "gte-cross-type-num-vs-str", "op": "gte", "a": { "type": "number", "raw": 1 },     "b": { "type": "string", "raw": "1" },    "expect": { "status": "Error", "code": "TYPE_MISMATCH", "operand": null } },
    { "id": "gt-both-boolean-not-orderable", "op": "gt", "a": { "type": "boolean", "raw": true }, "b": { "type": "boolean", "raw": false }, "expect": { "status": "Error", "code": "TYPE_MISMATCH", "operand": null } },

    { "id": "contains-true",           "op": "contains",  "a": { "type": "string", "raw": "hello world" }, "b": { "type": "string", "raw": "world" }, "expect": { "status": "True" } },
    { "id": "contains-false",          "op": "contains",  "a": { "type": "string", "raw": "hello world" }, "b": { "type": "string", "raw": "xyz" },   "expect": { "status": "False" } },
    { "id": "contains-case-sensitive", "op": "contains",  "a": { "type": "string", "raw": "Hello" },       "b": { "type": "string", "raw": "hello" }, "expect": { "status": "False" } },
    { "id": "ncontains-true",          "op": "ncontains", "a": { "type": "string", "raw": "hello" },       "b": { "type": "string", "raw": "xyz" },   "expect": { "status": "True" } },
    { "id": "contains-null-a",         "op": "contains",  "a": { "type": "string", "raw": null },          "b": { "type": "string", "raw": "x" },     "expect": { "status": "False" } },
    { "id": "ncontains-null-a",        "op": "ncontains", "a": { "type": "string", "raw": null },          "b": { "type": "string", "raw": "x" },     "expect": { "status": "True" } },
    { "id": "starts-true",             "op": "starts",    "a": { "type": "string", "raw": "foobar" },      "b": { "type": "string", "raw": "foo" },   "expect": { "status": "True" } },
    { "id": "starts-empty-b",          "op": "starts",    "a": { "type": "string", "raw": "foobar" },      "b": { "type": "string", "raw": "" },      "expect": { "status": "True" } },
    { "id": "ends-true",               "op": "ends",      "a": { "type": "string", "raw": "foobar" },      "b": { "type": "string", "raw": "bar" },   "expect": { "status": "True" } },

    { "id": "regex-match",             "op": "regex", "a": { "type": "string", "raw": "abc123" }, "b": { "type": "string", "raw": "[0-9]+" },  "expect": { "status": "True" } },
    { "id": "regex-no-match",          "op": "regex", "a": { "type": "string", "raw": "abc" },    "b": { "type": "string", "raw": "[0-9]+" },  "expect": { "status": "False" } },
    { "id": "regex-case-sensitive",    "op": "regex", "a": { "type": "string", "raw": "ABC" },    "b": { "type": "string", "raw": "abc" },     "expect": { "status": "False" } },
    { "id": "regex-inline-ignorecase", "op": "regex", "a": { "type": "string", "raw": "ABC" },    "b": { "type": "string", "raw": "(?i)abc" }, "expect": { "status": "True" } },
    { "id": "regex-null-a",            "op": "regex", "a": { "type": "string", "raw": null },      "b": { "type": "string", "raw": "x" },       "expect": { "status": "False" } },
    { "id": "regex-invalid-pattern",   "op": "regex", "a": { "type": "string", "raw": "abc" },    "b": { "type": "string", "raw": "[" },       "expect": { "status": "Error", "code": "INVALID_LOGIC", "operand": "b" } },

    { "id": "in-str-list-true",        "op": "in",  "a": { "type": "string", "raw": "b" }, "b": { "type": "string", "raw": "a,b,c" },  "expect": { "status": "True" } },
    { "id": "in-str-list-false",       "op": "in",  "a": { "type": "string", "raw": "z" }, "b": { "type": "string", "raw": "a,b,c" },  "expect": { "status": "False" } },
    { "id": "in-list-trim-drop-empty", "op": "in",  "a": { "type": "string", "raw": "b" }, "b": { "type": "string", "raw": "a, ,b," },  "expect": { "status": "True" } },
    { "id": "in-number-list",          "op": "in",  "a": { "type": "number", "raw": 2 },   "b": { "type": "string", "raw": "1,2,3" },  "expect": { "status": "True" } },
    { "id": "nin-true",                "op": "nin", "a": { "type": "string", "raw": "z" }, "b": { "type": "string", "raw": "a,b,c" },  "expect": { "status": "True" } },
    { "id": "in-null-a",               "op": "in",  "a": { "type": "string", "raw": null },"b": { "type": "string", "raw": "a,b" },    "expect": { "status": "False" } },
    { "id": "in-empty-list",           "op": "in",  "a": { "type": "string", "raw": "a" }, "b": { "type": "string", "raw": "" },       "expect": { "status": "False" } },

    { "id": "exists-nonnull",          "op": "exists",  "a": { "type": "string", "raw": "x" } , "expect": { "status": "True" } },
    { "id": "exists-null",             "op": "exists",  "a": { "type": "string", "raw": null }, "expect": { "status": "False" } },
    { "id": "exists-array",            "op": "exists",  "a": { "type": "string", "raw": [] },   "expect": { "status": "True" } },
    { "id": "nexists-null",            "op": "nexists", "a": { "type": "string", "raw": null }, "expect": { "status": "True" } },
    { "id": "empty-null",              "op": "empty",   "a": { "type": "string", "raw": null }, "expect": { "status": "True" } },
    { "id": "empty-emptystring",       "op": "empty",   "a": { "type": "string", "raw": "" },   "expect": { "status": "True" } },
    { "id": "empty-whitespace",        "op": "empty",   "a": { "type": "string", "raw": "   " },"expect": { "status": "True" } },
    { "id": "empty-empty-array",       "op": "empty",   "a": { "type": "string", "raw": [] },   "expect": { "status": "True" } },
    { "id": "empty-empty-object",      "op": "empty",   "a": { "type": "string", "raw": {} },   "expect": { "status": "True" } },
    { "id": "empty-nonempty-string",   "op": "empty",   "a": { "type": "string", "raw": "x" },  "expect": { "status": "False" } },
    { "id": "nempty-nonempty",         "op": "nempty",  "a": { "type": "string", "raw": "x" },  "expect": { "status": "True" } },

    { "id": "bool-true-on-true",       "op": "true",  "a": { "type": "boolean", "raw": true },  "expect": { "status": "True" } },
    { "id": "bool-true-on-false",      "op": "true",  "a": { "type": "boolean", "raw": false }, "expect": { "status": "False" } },
    { "id": "bool-false-on-false",     "op": "false", "a": { "type": "boolean", "raw": false }, "expect": { "status": "True" } },
    { "id": "bool-true-on-null",       "op": "true",  "a": { "type": "boolean", "raw": null },  "expect": { "status": "False" } },
    { "id": "bool-true-uncoercible",   "op": "true",  "a": { "type": "boolean", "raw": "abc" }, "expect": { "status": "Error", "code": "COERCION_FAILED", "operand": "a" } },

    { "id": "coerce-num-from-numeric-string", "op": "eq", "a": { "type": "number", "raw": "12" },   "b": { "type": "number", "raw": 12 },  "expect": { "status": "True" } },
    { "id": "coerce-num-fail-alpha",          "op": "eq", "a": { "type": "number", "raw": "abc" },  "b": { "type": "number", "raw": 1 },   "expect": { "status": "Error", "code": "COERCION_FAILED", "operand": "a" } },
    { "id": "coerce-num-fail-thousands",      "op": "eq", "a": { "type": "number", "raw": "1,000" },"b": { "type": "number", "raw": 1000 },"expect": { "status": "Error", "code": "COERCION_FAILED", "operand": "a" } },
    { "id": "coerce-num-fail-nan",            "op": "eq", "a": { "type": "number", "raw": "NaN" },  "b": { "type": "number", "raw": 1 },   "expect": { "status": "Error", "code": "COERCION_FAILED", "operand": "a" } },
    { "id": "coerce-bool-fail-from-number",   "op": "eq", "a": { "type": "boolean", "raw": 1 },     "b": { "type": "boolean", "raw": true },"expect": { "status": "Error", "code": "COERCION_FAILED", "operand": "a" } },
    { "id": "coerce-str-from-number",         "op": "eq", "a": { "type": "string", "raw": 1.5 },    "b": { "type": "string", "raw": "1.5" },"expect": { "status": "True" } },
    { "id": "coerce-scalar-fail-from-array",  "op": "eq", "a": { "type": "string", "raw": [1, 2] }, "b": { "type": "string", "raw": "x" }, "expect": { "status": "Error", "code": "COERCION_FAILED", "operand": "a" } },

    { "id": "unset-operand-a",         "op": "eq", "a": { "type": "string", "state": "unset" },       "b": { "type": "string", "raw": "x" }, "expect": { "status": "Incomplete" } },
    { "id": "unset-operand-b",         "op": "eq", "a": { "type": "string", "raw": "x" },             "b": { "type": "string", "state": "unset" }, "expect": { "status": "Incomplete" } },
    { "id": "unresolved-ref-a",        "op": "eq", "a": { "type": "string", "state": "unresolved" },  "b": { "type": "string", "raw": "x" }, "expect": { "status": "Error", "code": "RESOLUTION_FAILED", "operand": "a" } },
    { "id": "binary-missing-b",        "op": "eq", "a": { "type": "string", "raw": "x" },             "b": { "type": "string", "state": "absent" }, "expect": { "status": "Error", "code": "INVALID_LOGIC", "operand": "b" } },
    { "id": "unknown-operator",        "op": "frobnicate", "a": { "type": "string", "raw": "x" },     "b": { "type": "string", "raw": "y" }, "expect": { "status": "Error", "code": "INVALID_LOGIC", "operand": null } }
  ],

  "aggregation": [
    { "id": "and-all-true",              "comb": "and", "statuses": ["True", "True"],                "expect": "True" },
    { "id": "and-one-false",             "comb": "and", "statuses": ["True", "False"],               "expect": "False" },
    { "id": "or-all-false",              "comb": "or",  "statuses": ["False", "False"],              "expect": "False" },
    { "id": "or-one-true",               "comb": "or",  "statuses": ["True", "False"],               "expect": "True" },
    { "id": "and-false-and-incomplete",  "comb": "and", "statuses": ["False", "Incomplete"],         "expect": "Incomplete" },
    { "id": "or-true-or-incomplete",     "comb": "or",  "statuses": ["True", "Incomplete"],          "expect": "Incomplete" },
    { "id": "and-error-dominates",       "comb": "and", "statuses": ["True", "Error"],               "expect": "Error" },
    { "id": "or-error-beats-incomplete", "comb": "or",  "statuses": ["Incomplete", "Error"],         "expect": "Error" },
    { "id": "error-over-everything",     "comb": "and", "statuses": ["True", "Incomplete", "Error"], "expect": "Error" },
    { "id": "single-true",               "comb": "and", "statuses": ["True"],                        "expect": "True" }
  ]
}
