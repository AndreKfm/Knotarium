<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Knotarium.Core\Knotarium.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <!-- 3.x is the actively-maintained line (2.x risks stranding on future advisories). The parser
         already uses the modern interface model (IOpenApiSchema, OpenApiDocument.Parse), so the bump
         from 2.11 needed zero code changes — the big break was 1.x→2.0, not 2.x→3.x. -->
    <PackageReference Include="Microsoft.OpenApi" Version="3.9.0" />
    <PackageReference Include="Microsoft.OpenApi.YamlReader" Version="3.9.0" />
    <!-- Force the transitive native SQLite bundle (pulled by EntityFrameworkCore.Sqlite) off 2.1.11,
         which is affected by GHSA-2m69-gcr7-jv3q. bundle_e_sqlite3 aligns the whole SQLitePCLRaw graph. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
