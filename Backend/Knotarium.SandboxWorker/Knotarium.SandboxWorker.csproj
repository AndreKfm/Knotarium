<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The host locates the worker next to its own binaries; keep the exe name stable. -->
    <AssemblyName>Knotarium.SandboxWorker</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The worker is spawned from the HOST's output directory, where Microsoft.Extensions.*
         assemblies live in the ASP.NET Core shared framework rather than as local files.
         Referencing the same framework makes them resolve identically for the worker. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Knotarium.Core\Knotarium.Core.csproj" />
    <ProjectReference Include="..\Knotarium.NodeRuntime\Knotarium.NodeRuntime.csproj" />
  </ItemGroup>

</Project>
