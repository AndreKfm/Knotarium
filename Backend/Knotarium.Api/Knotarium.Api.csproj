<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- App version shown on the dashboard (GET /api/version). This is only the FALLBACK for a local
         or from-source build: every release overrides it via `publish.ps1 -Version`, which the release
         workflow feeds from the git tag, and the Docker image takes it from the VERSION build arg.
         Deliberately a non-release value, matching the Dockerfile's ARG VERSION=0.0.0 — a plausible
         number here (it used to read 0.1.4) shows up in the header of anyone following the README's
         "Run from source" path and contradicts the version actually shipped. Build time comes from the
         assembly file timestamp at runtime, so freshness is still visible without touching this. -->
    <Version>0.0.0-dev</Version>
    <!-- Brand icon embedded into the generated Windows apphost (Knotarium.Api.exe). Gives the
         executable — and therefore the Start-Menu shortcut, taskbar, Explorer, and the installer's
         Add/Remove Programs entry (UninstallDisplayIcon points at the exe) — a real icon instead of
         the generic blank one. Windows-only; ignored by the linux-x64 publish. -->
    <ApplicationIcon>knotarium.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the host run as a Windows service (used by the installer's service install mode).
         Harmless when launched interactively: UseWindowsService() no-ops unless the process is
         actually started by the Windows Service Control Manager. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Knotarium.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Built-in template gallery sources (reviewable JSON, packed to .kgtpl on demand at runtime). -->
    <Content Update="Templates\Sources\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Knotarium.Features\Knotarium.Features.csproj" />
    <ProjectReference Include="..\Knotarium.Features.Options\Knotarium.Features.Options.csproj" />
    <ProjectReference Include="..\Knotarium.Features.NodeEditor\Knotarium.Features.NodeEditor.csproj" />
    <ProjectReference Include="..\Knotarium.Features.Compiler\Knotarium.Features.Compiler.csproj" />
    <ProjectReference Include="..\Knotarium.Features.Settings\Knotarium.Features.Settings.csproj" />
    <ProjectReference Include="..\Knotarium.Features.OpenApi\Knotarium.Features.OpenApi.csproj" />
    <ProjectReference Include="..\Knotarium.Features.Portability\Knotarium.Features.Portability.csproj" />
    <ProjectReference Include="..\Knotarium.Features.Ai\Knotarium.Features.Ai.csproj" />
    <ProjectReference Include="..\Knotarium.Infrastructure\Knotarium.Infrastructure.csproj" />
    <ProjectReference Include="..\Knotarium.Core\Knotarium.Core.csproj" />
    <ProjectReference Include="..\Knotarium.NodeRuntime\Knotarium.NodeRuntime.csproj" />
    <!-- Sandbox worker: not referenced by code, but the ProjectReference makes its exe land next
         to the host binaries so the Process sandbox mode can spawn it. -->
    <ProjectReference Include="..\Knotarium.SandboxWorker\Knotarium.SandboxWorker.csproj" />
  </ItemGroup>

</Project>
