<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="OpenApi\Fixtures\**\*" />
  </ItemGroup>

  <!-- B2 shared condition fixtures: linked from docs/design (the single FE/BE source of truth, NOT
       copied) and emitted to the test output dir so the suite loads the same files the FE loads. -->
  <ItemGroup>
    <Content Include="..\..\docs\design\condition-conformance.fixture.json"
             Link="Condition\Fixtures\condition-conformance.fixture.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\design\condition-catalog.fixture.json"
             Link="Condition\Fixtures\condition-catalog.fixture.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\design\condition-tree.fixture.json"
             Link="Condition\Fixtures\condition-tree.fixture.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KnotGarden.Api\KnotGarden.Api.csproj" />
    <ProjectReference Include="..\KnotGarden.Core\KnotGarden.Core.csproj" />
    <ProjectReference Include="..\KnotGarden.Features\KnotGarden.Features.csproj" />
    <ProjectReference Include="..\KnotGarden.Features.OpenApi\KnotGarden.Features.OpenApi.csproj" />
    <ProjectReference Include="..\KnotGarden.Features.Portability\KnotGarden.Features.Portability.csproj" />
    <ProjectReference Include="..\KnotGarden.Features.Ai\KnotGarden.Features.Ai.csproj" />
    <ProjectReference Include="..\KnotGarden.Infrastructure\KnotGarden.Infrastructure.csproj" />
  </ItemGroup>

</Project>